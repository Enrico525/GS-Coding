# Copie para .env e preencha. O .env NUNCA vai para o Git.
DB_HOST=localhost
DB_PORT=3306
DB_USER=alerta_app
DB_PASSWORD=coloque_a_senha_aqui
DB_NAME=alertabairro

# Servidor web (Flask)
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Servidor de sockets TCP que distribui os alertas aos receptores
SOCKET_HOST=127.0.0.1
SOCKET_PORT=5050

# Arquivo de log
LOG_FILE=logs/alertabairro.log

# API externa de previsão do tempo (gratuita, sem chave)
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Intervalo mínimo (segundos) entre verificações do mesmo bairro
COOLDOWN_VERIFICACAO=30
